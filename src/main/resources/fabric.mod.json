{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "assets/sophisticatedfabriccompat/icon.png",
  "authors": ["Salandora"],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}",
    "sources": "${mod_sources_url}"
  },

  "environment": "*",
  "entrypoints": {
    "client": ["org.github.salandora.sophisticatedfabriccompat.client.SophisticatedFabricCompatClient"],
    "main": ["org.github.salandora.sophisticatedfabriccompat.SophisticatedFabricCompat"]
  },

  "mixins": [
    "sophisticatedfabriccompat.mixins.json",
    "compat/audioplayer.mixins.json",
    "compat/carpet.mixins.json",
    "compat/litematica.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
